CATALOGO_DB_NAME=catalogo_db
CATALOGO_DB_USER=catalogo_user
CATALOGO_DB_PASSWORD=
POSTGRES_PORT=5432

# Archivo PEM X.509 de la clave publica RSA del emisor (minimo 2048 bits)
CATALOGO_JWT_PUBLIC_KEY_LOCATION=file:/ruta/absoluta/svc-turnos-public.pem
CATALOGO_JWT_ISSUER=svc-turnos
CATALOGO_JWT_AUDIENCE=svc-catalogo-api

# Docker: archivo publico existente en el host (ruta absoluta, sin prefijo file:).
# Debe ser legible por el UID 10001. Nunca montar la clave privada de Turnos.
CATALOGO_JWT_PUBLIC_KEY_FILE=
CATALOGO_HTTP_PORT=8081

# Integracion tecnica: completar solo con valores asignados por la catedra.
CATEDRA_API_BASE_URL=
CATEDRA_API_TOKEN=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=svc-catalogo-local
KAFKA_CATALOGO_TOPIC=catalogo-no-configurado
KAFKA_LISTENER_AUTO_STARTUP=false

# Mantiene el arranque existente. Solo poner false para una prueba local sin integracion.
CATALOGO_RECONCILIACIONINICIO_ENABLED=true

# Habilitar para detectar versiones nuevas sin recibir Kafka ni reiniciar el servicio.
CATALOGO_RECONCILIACION_PERIODICA_ENABLED=false
CATALOGO_RECONCILIACION_PERIODICA_INTERVALO_MS=60000
CATALOGO_RECONCILIACION_PERIODICA_DEMORA_INICIAL_MS=60000
# Kafka: intervalo 1..10000 ms; reintentos 0..10. No descarta el mensaje al agotarlos.
KAFKA_CATALOGO_REINTENTO_INTERVALO_MS=2000
KAFKA_CATALOGO_REINTENTOS_MAXIMOS=3
